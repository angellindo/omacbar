+#[test]
+fn cancel_drag_on_leave_ends_a_held_drag_cancelled_at_the_leave() {
+    type State = Vec<(Phase, bool)>;
+    fn view(_: &State, _: &mut Cx<State>) -> El {
+        el().size(200.0, 200.0).child(el().key("pill").size(100.0, 40.0).cancel_drag_on_leave()
+            .on_drag(|s: &mut State, d, _| s.push((d.phase, d.cancelled()))))
+    }
+    let mut rt = Runtime::new(Vec::new(), view, (200.0, 200.0), Env::new(true, 1.0));
+    rt.frame(0.0);
+    rt.pointer_move(10.0, 10.0);
+    rt.pointer_down(10.0, 10.0);
+    rt.pointer_leave();
+    rt.frame(0.0);
+    assert_eq!(rt.state.last(), Some(&(Phase::Up, true)), "the leave cancels");
+    assert!(!rt.pressing());
+    assert_eq!(rt.pointer(), Some((10.0, 10.0)), "the host releases at its last position");
+    rt.pointer_move(10.0, 10.0);
+    rt.pointer_up(10.0, 10.0);
+    rt.frame(0.0);
+    assert_eq!(rt.state.iter().filter(|d| d.0 == Phase::Up).count(), 1, "coming back and releasing does nothing");
+}
